### create estimate

POST {{baseUrl}}/estimate/create-estimate HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "additionalMarkUp": 5.5,
  "clientId": "69dc92eb0dc5477223a0ff0f",
  "clientSign": true,
  "contractId": "69febbee5d2d85a94fa2f763",
  "coverPaymentProcessingFee": true,
  "date": "2026-04-01",
  "depositAmount": 300,
  "discountAmount": 100,
  "estimateName": "Residential Painting Project",
  "estimateNumber": "66",
  "format": "TABLE",
  "grandTotal": 1500,
  "isAutoInvoice": true,
  "isGroupingEnabled": true,
  "isOnlinePayment": true,
  "items": [
    {
      "id": "69d87eb901d75586feffc495",
      "quantity": 3,
      "subTotal": 450
    }
  ],
  "legendary": "legendary",
  "mySign": true,
  "noteForClient": "Thank you for your business! Please complete payment within 7 days.",
  "poNumber": "3344",
  "privateNote": "Repeat client, prefers email communication."
}


### create client

POST {{baseUrl}}/estimate/create-client HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "address": "123 Main Street",
  "city": "Dhaka",
  "clientName": "John Doe",
  "email": "johndoe@example.com",
  "phoneNumber": "+8801712345678",
  "state": "Dhaka Division",
  "zip": "1216"
}


### get my clients

GET {{baseUrl}}/estimate/my-clients HTTP/1.1
Authorization: {{estMir}}


### create markup

POST {{baseUrl}}/estimate/create-markup HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "name": "Standard Markup",
  "percentage": 15
}


### create markup with amount

POST {{baseUrl}}/estimate/create-markup HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "amount": 200,
  "name": "Flat Fee Markup"
}


### get all markups

GET {{baseUrl}}/estimate/all-markups HTTP/1.1
Authorization: {{estMir}}


### create item

POST {{baseUrl}}/estimate/create-item HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "description": "Premium interior wall paint per gallon",
  "format": "TABLE",
  "itemName": "Italian Balu",
  "markUpId": "69e04d6283a9851a096b7b0b",
  "notes": "Includes labor",

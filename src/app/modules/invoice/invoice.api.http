### create invoice

POST {{baseUrl}}/invoice/create HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "additionalMarkUp": 5.5,
  "clientId": "69dc92eb0dc5477223a0ff0f",
  "date": "2026-04-01",
  "depositAmount": 300,
  "discountAmount": 100,
  "endDate": "2026-04-30",
  "grandTotal": 1500,
  "invoiceName": "Residential Painting Project",
  "items": [
    {
      "id": "69d87eb901d75586feffc495",
      "quantity": 3,
      "subTotal": 450
    }
  ],
  "legendary": "legendary"
}


### get all invoices

GET {{baseUrl}}/invoice/all-invoices?page=1&limit=20&searchTerm=res&status=ACTIVE HTTP/1.1
Authorization: {{estMir}}


### get all invoices

GET {{baseUrl}}/invoice/all-invoices?page=1&limit=20&status=ACTIVE HTTP/1.1
Authorization: {{estMir}}


### get invoice details

GET {{baseUrl}}/invoice/details/69ddf702378f36b27a299483 HTTP/1.1
Authorization: {{estMir}}


### Send invoice email

POST {{baseUrl}}/invoice/send-email/69e71abbeb445ea74ae9a560 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "message": "Thanks for your business!",
  "sendMeCopy": true,
  "subject": "Your Invoice from Geo Paving and Sealcoating",
  "to": [
    "dev.shahjalal@gmail.com",
    "muhommodshahjalal@gmail.com"
  ]
}


### Update invoice email status to READ and sign invoice

PATCH {{baseUrl}}/invoice/update-email-sign/69e71abbeb445ea74ae9a560 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "emailStatus": "READ",
  "signedName": "John Doe"
}


### Generate invoice from estimate

# /: estimateId

POST {{baseUrl}}/invoice/generate-from-estimate/69e71ad3eb445ea74ae9a561 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json


### record manual payment

# /:invoiceId

POST {{baseUrl}}/invoice/record-payment/69e70277a0a5737b61ddebb5 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "amount": 20,
  "checkNumber": "CHK123456",
  "paymentDate": "2026-04-20T00:00:00Z",
  "paymentMethod": "CHECK"
}


### get payments for a invoice

GET {{baseUrl}}/invoice/payments/69e70277a0a5737b61ddebb5 HTTP/1.1
Authorization: {{estMir}}


### view original payment from refund | get payment details

GET {{baseUrl}}/invoice/payment-details/69eeffe64f8f669f1922d996 HTTP/1.1
Authorization: {{estMir}}


### refund paymnet

# /:paymentId

POST {{baseUrl}}/invoice/refund-payment/69eeffe64f8f669f1922d996 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "amount": 1,
  "reason": "Testing error"
}



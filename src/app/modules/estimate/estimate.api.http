  "taxes": [
    "69e6fa64a0a5737b61ddebb0"
  ]
}


### update item

PATCH {{baseUrl}}/estimate/update-item HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "description": "Heavy duty exterior steel door",

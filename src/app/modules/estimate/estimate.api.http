  "privateNote": "Client requested extra sealcoating"
}


### Update estimate images – remove a fileUrl

PATCH {{baseUrl}}/estimate/estimate-images/69fec7765d2d85a94fa2f764 HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "fileUrls": [
    "https://space.com/old-file.pdf"
  ],
  "fileUrlsAction": "remove"
}


### Update estimate images – replace sideMap

PATCH {{baseUrl}}/estimate/estimate-images/69fec7765d2d85a94fa2f764 HTTP/1.1
Authorization: {{admin}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="bodyData"
Content-Type: application/json

{
  "sideMapAction": "replace"
}

------WebKitFormBoundary
Content-Disposition: form-data; name="sideMap"; filename="new-map.jpg"
Content-Type: image/jpeg

< ./new-map.jpg
------WebKitFormBoundary--


### Add two new fileUrls

PATCH {{baseUrl}}/estimate/estimate-images/69fec7765d2d85a94fa2f764 HTTP/1.1
Authorization: {{admin}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="bodyData"
Content-Type: application/json

{
  "fileUrlsAction": "add"
}

------WebKitFormBoundary
Content-Disposition: form-data; name="fileUrls"; filename="doc1.pdf"
Content-Type: application/pdf

< ./doc1.pdf
------WebKitFormBoundary
Content-Disposition: form-data; name="fileUrls"; filename="doc2.pdf"
Content-Type: application/pdf

< ./doc2.pdf
------WebKitFormBoundary--

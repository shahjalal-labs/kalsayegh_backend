### create office

POST {{baseUrl}}/job-request/office-create HTTP/1.1
Authorization: {{officeAdmin}}
Content-Type: application/json

{
  "address": "konabari",
  "name": "office3"
}


### get office

GET {{baseUrl}}/job-request/office HTTP/1.1
Authorization: {{officeAdmin}}


### update office

PATCH {{baseUrl}}/job-request/office-update/6a4b42d7f7819c55817fa921 HTTP/1.1
Authorization: {{officeAdmin}}
Content-Type: application/json

{
  "address": "Salt lake",
  "name": "office3"
}


### delete office

DELETE {{baseUrl}}/job-request/office-delete/6a4b42d7f7819c55817fa921 HTTP/1.1
Authorization: {{officeAdmin}}


### create job request

POST {{baseUrl}}/job-request/create-job-request HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "address": "123 Main Street, Dhaka",
  "contact": "+8801712345678",
  "date": "2026-01-01T10:00:00Z",
  "email": "client@example.com",
  "jobSerial": 9,
  "note": "Install new network hardware",
  "officeId": "69d5edc0810a2cd30c06ee1c",
  "officeLatitude": 23.8103,
  "officeLongitude": 90.4125,
  "title": "new job request title2"
}


### create job request by image

POST {{baseUrl}}/job-request/create-job-request-by-image HTTP/1.1
Authorization: {{administrator}}
Content-Type: application/json

{
  "date": "2026-01-01T10:00:00Z",
  "officeId": "69d5edc0810a2cd30c06ee1c",
  "title": "new job request title2"
}


### get all job requests

GET {{baseUrl}}/job-request/all HTTP/1.1
Authorization: {{admin}} HTTP/1.1


### get job request details

GET {{baseUrl}}/job-request/details/6a042657e2fd2a426a250ec6 HTTP/1.1
Authorization: {{admin}} HTTP/1.1


### update job request

PATCH {{baseUrl}}/job-request/update-job-request/69e862e85e7ca726664ef1de HTTP/1.1
Authorization: {{administrator}}
Content-Type: application/json

{
  "address": "123 Main Street, Dhaka",
  "contact": "+8801712345678",
  "date": "2026-01-01T10:00:00Z",
  "email": "client@example.com",
  "note": "Install new network hardware",
  "officeLatitude": 23.8103,
  "officeLongitude": 90.4125,
  "status": "REVIEWED",
  "title": "10 Storyed building for school"
}


### get all job requests for a office

# requests-for-office/:officeId

GET {{baseUrl}}/job-request/requests-for-office/69d5edc0810a2cd30c06ee1c HTTP/1.1
Authorization: {{admin}}

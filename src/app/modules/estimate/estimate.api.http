Authorization: {{estMir}}


### get all estimates

GET {{baseUrl}}/estimate/all-estimates?page=1&limit=20&searchTerm=kitchen&status=Approved HTTP/1.1
Authorization: {{estMir}}


### get all estimates

GET {{baseUrl}}/estimate/all-estimates?page=1&limit=10 HTTP/1.1
Authorization: {{admin}}


### get estimate details

GET {{baseUrl}}/estimate/estimate/69e71ad3eb445ea74ae9a561 HTTP/1.1
Authorization: {{estMir}}


### send estimate mail

# send-mail/:estimateId

POST {{baseUrl}}/estimate/send-mail/69d9eec4531af0c6f2ebc13a HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json


### update estimate status (Pending / Approved / Declined)

# update-status/:estimateId

PATCH {{baseUrl}}/estimate/update-status/69e71ad3eb445ea74ae9a561 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "status": "Approved"
}


### update estimate email status and sign estimate

# update-email-sign/:estimateId

PATCH {{baseUrl}}/estimate/update-email-sign/69e71ad3eb445ea74ae9a561 HTTP/1.1
Content-Type: application/json

{
  "emailStatus": "READ",
  "mySignAt": "2026-05-11T00:00:00.000Z",
  "mySignName": "Kal Sayegh",
  "signedName": "Mir Bin Mota"
}


### Send estimate email with custom recipients, CC, BCC, and copy to me

# /:estimateId

POST {{baseUrl}}/estimate/send-email/69e71ad3eb445ea74ae9a561 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "bcc": [],
  "cc": [],
  "message": "We are pleased to work with you. Please review the estimate.",
  "sendMeCopy": true,
  "subject": "Your Estimate #2525 from Geo Paving and Sealcoating",
  "to": [
    "dev.shahjalal@gmail.com",
    "muhommodshahjalal@gmail.com"
  ]
}


### delete estimate

# /:estimateId

DELETE {{baseUrl}}/estimate/delete/69fda10972d7bcfae8a6b967 HTTP/1.1
Authorization: {{admin}}


### get estimate number

GET {{baseUrl}}/estimate/estimate-number HTTP/1.1
Authorization: {{admin}}


### 1. Update estimate without files (JSON)

PATCH {{baseUrl}}/estimate/edit-estimate/69e71ad3eb445ea74ae9a561 HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "additionalMarkUp": 8.5,
  "clientId": "69dcbc491d6f350e20bbd0ea",
  "clientSign": false,
  "contractId": "6a032fd2ba5bfdd401447448",
  "coverPaymentProcessingFee": true,
  "date": "2026-05-01",
  "depositAmount": 500.00,
  "discountAmount": 150.00,
  "endDate": "2026-06-15",
  "estimateName": "Updated Estimate - Driveway Resurfacing",
  "format": "TABLE",
  "grandTotal": 2500.00,
  "isAutoInvoice": true,
  "isGroupingEnabled": true,
  "isOnlinePayment": true,
  "items": [
    {
      "id": "69d9e204785ffd2b312e8483",
      "quantity": 4,
      "subTotal": 600
    }
  ],
  "legendary": "Summer promotion discount applied",
  "mySign": true,
  "noteForClient": "Deposit required to secure schedule.",

### create invoice

POST {{baseUrl}}/invoice/create HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "additionalMarkUp": 5.5,
  "clientId": "69dc92eb0dc5477223a0ff0f",
  "clientSign": true,
  "contractId": "69fea25e9fce00a88b43c08a",
  "coverPaymentProcessingFee": true,
  "date": "2026-04-01",
  "depositAmount": 300,
  "discountAmount": 100,
  "endDate": "2026-04-30",
  "format": "TABLE",
  "grandTotal": 1500,
  "invoiceName": "Residential Painting Project",
  "isOnlinePayment": true,
  "items": [
    {
      "id": "69d87eb901d75586feffc495",
      "quantity": 3,
      "subTotal": 450
    }
  ],
  "legendary": "legendary",
  "mySign": true,
  "noteForClient": "Online payment enabled. Fees included."
}


### update invoice

# /:invoiceId

PATCH {{baseUrl}}/invoice/update/69fec7765d2d85a94fa2f764 HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "additionalMarkUp": 5.5,
  "clientId": "69dc92eb0dc5477223a0ff0f",
  "clientSign": true,
  "contractId": "69fea25e9fce00a88b43c08a",
  "coverPaymentProcessingFee": true,
  "date": "2026-04-01",
  "depositAmount": 300.00,
  "discountAmount": 100.00,
  "endDate": "2026-04-30",
  "format": "TABLE",
  "grandTotal": 1500.00,
  "invoiceName": "Updated Invoice Name",
  "isOnlinePayment": true,
  "items": [
    {
      "id": "69d87eb901d75586feffc495",
      "quantity": 3,
      "subTotal": 450
    }
  ],
  "legendary": "Special offer text",
  "mySign": true,
  "noteForClient": "Note visible to client",
  "privateNote": "Internal note"
}


### get all invoices

GET {{baseUrl}}/invoice/all-invoices?page=1&limit=20&searchTerm=res&status=ACTIVE HTTP/1.1
Authorization: {{estMir}}


### get all invoices

GET {{baseUrl}}/invoice/all-invoices?page=1&limit=20&status=ACTIVE HTTP/1.1
Authorization: {{estMir}}


### get invoice details

GET {{baseUrl}}/invoice/details/69fed1c2f5472591e0ad4cd2 HTTP/1.1
Authorization: {{estMir}}


### Send invoice email

POST {{baseUrl}}/invoice/send-email/69e1cd3e746f0ebcda851c80 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "message": "Thanks for your business!",
  "sendMeCopy": false,
  "subject": "Your Invoice from Geo Paving and Sealcoating",
  "to": [
    "shahjalal.backend@gmail.com"
  ]
}


### Update invoice email status to READ and sign invoice

PATCH {{baseUrl}}/invoice/update-email-sign/69fed1c2f5472591e0ad4cd2 HTTP/1.1
Authorization: {{estMir}}
Content-Type: application/json

{
  "emailStatus": "READ",
  "mySignAt": "2026-05-11T00:00:00.000Z",
  "mySignName": "Kal Sayegh",
  "signedName": "John Doe"
}



### create invoice with subline items

POST {{baseUrl}}/invoice/create HTTP/1.1
Authorization: {{admin}}
Content-Type: application/json

{
  "additionalMarkUp": 5.5,
  "clientId": "69dc92eb0dc5477223a0ff0f",
  "clientSign": true,
  "contractId": "6a032fd2ba5bfdd401447448",
  "coverPaymentProcessingFee": true,
  "date": "2026-04-01",
  "depositAmount": 300,
  "discountAmount": 100,
  "endDate": "2026-04-30",
  "format": "TABLE",
  "grandTotal": 1500,
  "invoiceName": "Residential Painting Project",
  "invoiceNumber": "66",
  "isGroupingEnabled": true,
  "isOnlinePayment": true,
  "items": [
    {
      "id": "69d87eb901d75586feffc495",
      "quantity": 3,
      "subTotal": 450
    }
  ],
  "legendary": "legendary",
  "mySign": true,
  "noteForClient": "Online payment enabled. Fees included.",
  "poNumber": "3344",
  "subItems": [
    {
      "itemId": "69d87eb901d75586feffc495",
      "price": 100,
      "quantity": 2,
      "title": "Extra surface preparation",
      "unitCost": 50
    },
    {
      "itemId": "69d87eb901d75586feffc495",
      "price": 75,
      "quantity": 1,
      "title": "Disposal of old paint",
      "unitCost": 75
    }
  ]
}


